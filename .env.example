# Copy to .env and fill in:  cp .env.example .env
# Prisma CLI reads .env only; Next.js also reads .env.local. Keep both on the same database.

# ── Database ─────────────────────────────────
# Neon recommended; use a dedicated branch for local dev.
# Runtime connection through the pooler (host ends in -pooler, pgbouncer=true):
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection for the Prisma CLI (db push, studio):
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth (NextAuth) ──────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
# Public base URL of the app (also used as the website link in emails).
NEXTAUTH_URL="http://localhost:3000"

# ── Seed (npm run seed) ──────────────────────
OWNER_EMAIL="owner@example.com"
# Required by the seed script, minimum 12 characters.
OWNER_PASSWORD=""

# ── Email (optional) ─────────────────────────
# Without RESEND_API_KEY no emails are sent; booking still works.
RESEND_API_KEY=""
# Sender address on a domain verified in Resend. Defaults to onboarding@resend.dev.
RESEND_FROM_EMAIL=""

# ── Reminder cron ────────────────────────────
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Required for /api/cron/reminders.
CRON_SECRET=""
# Remind guests whose reservation starts within this many hours (default 24).
REMINDER_HORIZON_HOURS="24"

# ── Demo data (npm run seed:demo) ────────────
# The demo seed WIPES the database. It only runs when DATABASE_URL contains
# DEMO_DB_HOST (e.g. the host of a dedicated Neon branch).
DEMO_DB_HOST=""
# Password for the three demo users (min 12 characters).
DEMO_PASSWORD=""
